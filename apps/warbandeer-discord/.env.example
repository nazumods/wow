# Discord (required)
DISCORD_TOKEN=your-bot-token
ANNOUNCE_CHANNEL_ID=123456789012345678
# Separate channel for release announcements (optional; falls back to ANNOUNCE_CHANNEL_ID)
RELEASE_ANNOUNCE_CHANNEL_ID=
# Register slash commands to a single guild for instant availability (optional;
# omitting registers globally, which can take up to an hour to propagate)
GUILD_ID=
# Prefix for slash-command names, e.g. r_ → /r_dmf, /r_reset, /r_status. Set this to run a
# second (debug/staging) bot in the same server without command collisions. Lowercase
# letters/numbers/-/_ only (Discord rule); leave blank for the normal command names.
COMMAND_PREFIX=

# WoW region: us | eu (drives reset times and DMF timezone defaults)
WOW_REGION=us

# Realm to watch for server-up announcements on reset day (optional; needs Blizzard creds)
WOW_REALM=stormrage

# Blizzard API client credentials from https://develop.battle.net (optional;
# without them /status and server-up announcements are disabled)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# GitHub repo whose releases get announced
GITHUB_REPO=nazumods/wow
# GitHub token. Optional for release polling (raises the rate limit); REQUIRED for /report,
# where it must have issues:write on the reportable repos (a roshne PAT covers wow + abm).
GITHUB_TOKEN=

# Discord role ID allowed to use /report — required to enable /report. Right-click the role
# -> Copy Role ID (Developer Mode on). Unset -> /report replies that it isn't configured.
REPORT_ROLE_ID=

# Override the timezone DMF opens in (defaults: us=America/Los_Angeles, eu=Europe/Paris)
DMF_TIMEZONE=
