node_modules/
.env
data/
# ops/bot-ops.sh env-set writes a timestamped copy of .env beside it before applying a change.
# That copy holds the live DISCORD_TOKEN and BLIZZARD_CLIENT_SECRET, and this is a public repo:
# untracked, it sits one `git add -A` from being published, and `git reset --hard` won't clear it.
.env.bak.*
